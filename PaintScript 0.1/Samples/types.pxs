/*
	When it comes to types, PaintScript is closer to ActionScript than JavaScript.
*/

global var name:String = "Nino"; // type = String

global function sayName(params:type):void
{
	say(name);
	call @refresh;
}

var num1 = 5; // type = * (any)
var num2:* = 7; // type = * (any)

var age:Number = 16; // type = Number

var point:int = 39;
global const PI:Number = 3.14;

// And instead of 'null' we have 'empty'.