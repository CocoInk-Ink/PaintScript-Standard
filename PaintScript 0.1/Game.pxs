#Sprite Sprite_1

var Exit:String = empty;

var jumpKey = 0;

var gravity = 0;

var keys = {};

@Start {
	forever {
		Reset();
		GameLoop();
	}
}

@Keydown(key:KeyboardKey) {
	keys[key.name] = key;
}

@Keyup(key:KeyboardKey) {
	keys[key.name] = empty;
}

function isKeyPressed(key:*):Boolean {
	var answer:String = empty;

	if (key is KeyboardKey kk) {
		if (keys[kk.name] != empty) answer = true;
		else answer = false;
	} else if (key is String ks) {
		if (keys[ks] != empty) answer = true;
		else answer = false;
	} else answer = false;

	return answer;
}

function GameLoop() {
	repeat until(Exit != empty) {

		// Switch to hitbox
		SwitchSkin("Hitbox");

		// Process logic
		BroadcastAndWait Tick;
		Tick();

		// Set skin
		SetSpriteSkin();

		// Refresh Screen
		call @Refresh;
	}
}

function Reset() {
	x = 0;
	y = 0;
	gravity = 0;
	Exit = empty;
}

function SetSpriteSkin() {
	if (gravity > 0 && jumpKey > 0) {}
}

function HandleKeys() {
	const jumpKeyPressed:Boolean = isKeyPressed("Space") || isKeyPressed("W"), isKeyPressed("Up Arrow");

	if (jumpKeyPressed && jumpKey < 2) {
		gravity = 20;
		jumpKey++;
	}

	if (isKeyPressed("Left Arrow") || isKeyPressed("A")) {
		changeVar(x, -3)
	}
	if (isKeyPressed("Right Arrow") || isKeyPressed("D")) {
		changeVar(x, 3);
	}
}

@receive Tick { }

function Tick() {
	HandleKeys();

	changeVar(this.y, gravity);
	gravity--;

	while (isTouching(get)) {}
}